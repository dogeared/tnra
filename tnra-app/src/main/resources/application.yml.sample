spring:
  security:
    oauth2:
      client:
        registration:
          keycloak:
            client-id: ${KEYCLOAK_CLIENT_ID:tnra-app}
            client-secret: ${KEYCLOAK_CLIENT_SECRET:tnra-app-secret}
            scope: openid,profile,email
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
        provider:
          keycloak:
            issuer-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/tnra}
            authorization-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/tnra}/protocol/openid-connect/auth
            token-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/tnra}/protocol/openid-connect/token
            user-info-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/tnra}/protocol/openid-connect/userinfo
            user-name-attribute: sub
            jwk-set-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/tnra}/protocol/openid-connect/certs
  jpa:
    hibernate:
      ddl-auto: validate
  datasource:
    url: jdbc:mysql://localhost:3307/tnra
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
  flyway:
    baseline-on-migrate: true
    baseline-version: 1
    locations: classpath:db/migration
  profiles:
    active: local
tnra:
  auth:
    login-registration-id: keycloak
  app:
    base-url: ${APP_BASE_URL:http://localhost:8080}
  notify:
    schedule: "0 0 12 * * ?"
  emailService:
    enabled: false
  # Billing is OFF by default (open-source self-host runs the full app with no payment surface).
  # SaaS deploys set enabled=true and point at the central tnra-billing-app with the per-group token
  # minted at provisioning. When enabled, api-url and api-token are required (fail fast if missing).
  billing:
    enabled: ${TNRA_BILLING_ENABLED:false}
    api-url: ${TNRA_BILLING_API_URL:http://localhost:8082}
    api-token: ${TNRA_BILLING_API_TOKEN:}
server:
  port: 8080
  servlet:
    context-path: /
    session:
      timeout: 30d
  forward-headers-strategy: native
vaadin:
  productionMode: false
  pnpm:
    enable: false
  devmode:
    # Vaadin 25 gates the dev tools on the CLIENT address (not the Host header). Through the nginx dev
    # proxy + Docker Desktop's NAT the client is a private-range address, so allow the private ranges.
    # Do NOT set devmode.remoteAddressHeader here: server.forward-headers-strategy=native makes Tomcat
    # resolve X-Forwarded-For into the remote address and strip the header, so a header check sees null
    # and denies. Dev only — this block is not in production config.
    hostsAllowed: localhost,127.0.0.1,10.*,172.*,192.168.*
logging:
  level:
    org.springframework.security: WARN
    com.vaadin: INFO
    org.springframework.web: WARN
mailgun:
  key:
    private: YOUR_MAILGUN_PRIVATE_KEY
    public: YOUR_MAILGUN_PUBLIC_KEY
  url: https://api.mailgun.net/v3/YOUR_DOMAIN/messages
app:
  file-storage:
    upload-dir: uploads
    base-url: /uploads
