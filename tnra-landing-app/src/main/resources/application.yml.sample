# Sample base config for tnra-landing-app.
#
# application.yml itself is gitignored (per the repo's `*.yml` rule), so each environment keeps a
# local copy. Copy this file before running or building the landing app:
#   cp tnra-landing-app/src/main/resources/application.yml.sample \
#      tnra-landing-app/src/main/resources/application.yml
#
# The dev defaults below run zero-config against the dockerized dev MySQL — the `tnra` user and
# `tnra_landing` database created by mysql/init-local-user.sql. Production overrides the datasource
# (url/username/password) and notify/mailgun values via SPRING_DATASOURCE_* / TNRA_* / MAILGUN_*
# env in docker-compose.production.yml, so the dev values here are never used there.
spring:
  jpa:
    hibernate:
      ddl-auto: validate
  datasource:
    url: jdbc:mysql://localhost:3307/tnra_landing?useSSL=false&allowPublicKeyRetrieval=true
    username: tnra
    password: 123456aA$
  flyway:
    baseline-on-migrate: true
    baseline-version: 0
    locations: classpath:db/migration
  h2:
    console:
      enabled: false

server:
  port: 8081
  servlet:
    context-path: /
    session:
      timeout: 30m
  forward-headers-strategy: framework

vaadin:
  productionMode: false
  devmode:
    # Vaadin 25 gates the dev tools on the CLIENT address (not the Host header). Through the nginx dev
    # proxy + Docker Desktop's NAT the client is a private-range address, so allow the private ranges.
    # Dev only — this block is not in production config.
    hostsAllowed: localhost,127.0.0.1,10.*,172.*,192.168.*

tnra:
  # Public origin of this site, used for absolute Open Graph URLs (og:url / og:image in link previews).
  # Only override off production (e.g. https://landing.dev.dogeared.dev on the dev site).
  site:
    base-url: ${TNRA_SITE_BASE_URL:https://tnra.app}
  notify:
    founder-email: ${TNRA_FOUNDER_EMAIL:tnra@dogeared.dev}
    enabled: ${TNRA_NOTIFY_ENABLED:true}
  # Optional HTTP Basic gate over the whole site. Default off (public). Set
  # enabled=true plus username/password to password-protect a production deploy
  # for private review before launch. Enabling without credentials fails fast.
  basic-auth:
    enabled: ${TNRA_BASIC_AUTH_ENABLED:false}
    username: ${TNRA_BASIC_AUTH_USERNAME:}
    password: ${TNRA_BASIC_AUTH_PASSWORD:}

  # Paddle.js for the /pay checkout page (the Paddle "default payment link"). The client-side token is
  # NOT the billing service's API key — it's a public token that can only open checkouts. Blank ⇒ /pay
  # shows "not configured" (self-host / billing-off deploys need nothing here). environment must match
  # the token: sandbox (test_…) or production (live_…).
  paddle:
    client-token: ${PADDLE_CLIENT_TOKEN:}
    environment: ${PADDLE_ENVIRONMENT:sandbox}

mailgun:
  key:
    private: ${MAILGUN_KEY_PRIVATE:}
  url: ${MAILGUN_URL:}

logging:
  level:
    com.afitnerd.tnra.landing: INFO
    org.springframework.security: WARN
    com.vaadin: INFO
