*.sql
# Flyway migrations are source, in EVERY module. (A pattern with a slash is anchored to this
# directory, so the old `!src/main/resources/...` form only un-ignored the repo root and silently
# dropped tnra-billing-app's V1 from `git add .`.)
!**/src/main/resources/db/migration/*.sql
!mysql/*.sql

