# TNRA environment variables — copy to .env and fill in values
# Docker Compose reads this via env_file (plain KEY=VALUE, no 'export')

# --- Infrastructure ---
MYSQL_ROOT_PASSWORD=
# Cloudflare Tunnels only — leave blank for VPS/Nginx setup
# Get token from: Cloudflare dashboard → Zero Trust → Networks → Tunnels → your tunnel → Configure
CLOUDFLARE_TUNNEL_TOKEN=

# --- Keycloak (LOCAL DEV ONLY — docker-compose.yml's disposable Keycloak) ---
# Production identity is the central Keycloak in the dogeared/keycloak repo, configured there; the
# group containers' OIDC settings come from each provision/<group>/docker-compose.yml.
KEYCLOAK_CLIENT_ID=tnra-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/tnra
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- App (needed for full-stack Docker mode) ---
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1
VAADIN_PRODUCTIONMODE=
TNRA_NOTIFY_SCHEDULE=

# --- Encryption ---
# Generate with: openssl rand -base64 32
# WARNING: set once before first startup and never change — rotating this key
# without re-encrypting all data will make all stored post content unreadable.
TNRA_ENCRYPTION_MASTER_KEY=

# --- Email (landing-page "Request Access" notifications, via Mailgun) ---
# Account-wide private API key, or a sending key for the domain in MAILGUN_URL.
MAILGUN_KEY_PRIVATE=
MAILGUN_KEY_PUBLIC=
# Full messages endpoint of an ACTIVE, verified sending domain:
#   https://api.mailgun.net/v3/<sending-domain>/messages   (api.eu.mailgun.net for EU-region domains)
# A suspended domain answers 403 "not allowed to send" — check with `curl -u api:$MAILGUN_KEY_PRIVATE`.
MAILGUN_URL=
# Where the notifications are sent (the founder). Default micah@tnra.app (Cloudflare Email Routing forwards it).
TNRA_FOUNDER_EMAIL=
# Sender address. Keep it on (or under) the sending domain in MAILGUN_URL so SPF/DKIM align with the
# From domain; a mismatch lands the mail in spam. Default: tnra-landing@tnra.app (fine with mail.tnra.app).
TNRA_NOTIFY_FROM=

# --- Landing page ---
# Host port the landing container publishes on 127.0.0.1 (local/debug access only;
# routing goes through the tnra-shared network). Change if 8081 is already in use.
TNRA_LANDING_PORT=8081
# Public origin of the landing site, used for absolute Open Graph URLs (og:url / og:image) in link
# previews. Default https://tnra.app — only override on a non-production host.
TNRA_SITE_BASE_URL=

# --- Landing page basic-auth gate (optional, for private pre-launch review) ---
# Set ENABLED=true and both credentials to password-protect the landing site.
# Leave disabled (blank/false) for the public deploy.
TNRA_BASIC_AUTH_ENABLED=
TNRA_BASIC_AUTH_USERNAME=
TNRA_BASIC_AUTH_PASSWORD=

# --- Central billing (Paddle, Merchant of Record) — only for the paid SaaS deploy ---
# Leave blank for self-host / non-paid deploys (the billing service is then not run).
# See PRODUCTION.*.md "Central Billing Service" and BILLING_PLAN_LOCAL_TESTING.md.
PADDLE_API_KEY=
# Paddle API base: https://sandbox-api.paddle.com (sandbox) or https://api.paddle.com (live)
PADDLE_API_BASE=https://sandbox-api.paddle.com
# Notification destination secret key (pdl_ntfset_...)
PADDLE_WEBHOOK_SECRET=
# Paddle Price ids for the $7/mo and $60/yr plans
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# Paddle.js client-side token (test_… for sandbox, live_… for live) — used by the LANDING app's /pay page,
# which is the Paddle "default payment link". Public by design; it can only open checkouts.
PADDLE_CLIENT_TOKEN=
# sandbox | production — must match PADDLE_CLIENT_TOKEN and PADDLE_API_BASE
PADDLE_ENVIRONMENT=sandbox
# Guards the provisioning/admin API (X-Admin-Token). Blank ⇒ admin API disabled (fail closed).
# Generate with: openssl rand -hex 24
BILLING_ADMIN_TOKEN=
# Default free-trial window (days) applied to a new group at registration.
TNRA_TRIAL_DAYS=60
# Host port the billing container publishes on 127.0.0.1 (local/debug only; routing goes through the
# tnra-shared network). Change if 8082 is already in use on the host. (Renamed from BILLING_PORT in
# 10.6.1; the old name is still read as a fallback.)
TNRA_BILLING_PORT=8082
# Override only when the billing DB is not the shared MySQL container (e.g. billing on its own VM).
# Default: jdbc:mysql://mysql:3306/tnra_billing?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
BILLING_DATASOURCE_URL=
# "Free period ending" reminder emails (billing service): sent via the MAILGUN_* settings above, from
# TNRA_NOTIFY_FROM, 7 days before a group trial / member waiver ends. Link target per group; {slug} is replaced.
BILLING_GROUP_URL_PATTERN=https://{slug}.tnra.app
# Per-group API tokens (minted by `POST /api/admin/groups`, shown once). One variable per group, named
# TNRA_BILLING_API_TOKEN_<GROUP> and referenced from that group's provision/<group>/docker-compose.yml
# as TNRA_BILLING_API_TOKEN: "${TNRA_BILLING_API_TOKEN_<GROUP>}" — so the overlay file holds no secret.
# e.g. TNRA_BILLING_API_TOKEN_THE_OG=

# --- Monitoring ---
DD_AGENT_MAJOR_VERSION=
DD_API_KEY=
DD_SITE=

# --- Logging ---
LOGGING_LEVEL_COM_AFITNERD_TNRA=
LOGGING_LEVEL_ORG_APACHE_HTTP=
LOGGING_LEVEL_ORG_APACHE_HTTP_WIRE=
